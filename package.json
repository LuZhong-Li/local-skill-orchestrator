{
  "name": "skill-manager",
  "version": "0.5.2",
  "private": true,
  "description": "Skill 元信息管理器的内核与桌面外壳",
  "type": "module",
  "workspaces": [
    "kernel",
    "gui",
    "contract"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:kernel && npm run build:desktop",
    "build:kernel": "node scripts/build-kernel.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "build:icon:icns": "node scripts/build-icon-icns.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "check": "npm run check:contract && npm run check:layer && npm run check:arch-graph && npm run check:complexity && npm run check:test-fixtures",
    "check:contract": "node scripts/check-contract.mjs",
    "check:layer": "node scripts/check-layer.mjs",
    "check:arch": "node scripts/check-layer.mjs",
    "check:arch-graph": "node scripts/generate-architecture-graph.mjs --check",
    "check:complexity": "node scripts/check-complexity.mjs",
    "check:test-fixtures": "node scripts/check-test-fixtures.mjs",
    "arch:baseline": "node scripts/check-complexity.mjs --write",
    "arch:graph": "node scripts/generate-architecture-graph.mjs",
    "typecheck": "npm run typecheck:contract && npm run typecheck:kernel && npm run typecheck:gui",
    "typecheck:contract": "tsc --noEmit -p contract/tsconfig.json",
    "typecheck:kernel": "tsc --build kernel/tsconfig.json",
    "typecheck:gui": "npm run typecheck -w @skill-manager/gui",
    "test": "node --test tests/unit/*.test.ts tests/contract/*.test.ts tests/e2e/*.test.ts",
    "smoke:gui": "node scripts/gui-smoke.mjs",
    "smoke:kernel": "node scripts/smoke-kernel.mjs",
    "probe:inventory": "node scripts/probe-host-inventory.mjs",
    "probe:reconcile": "node scripts/probe-reconcile-actions.mjs",
    "bench:fixture": "node scripts/bench/fixture-cli.mjs",
    "bench": "node scripts/bench/runner.mjs",
    "check:node": "node scripts/check-node-version.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:slow": "node --test tests/slow/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
