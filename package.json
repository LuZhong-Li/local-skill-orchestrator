{
  "name": "skill-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Skill 元信息管理器的内核与桌面外壳",
  "type": "module",
  "workspaces": [
    "kernel",
    "gui"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:kernel && npm run build:desktop",
    "build:kernel": "node scripts/build-kernel.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "check": "npm run check:contract && npm run check:layer",
    "check:contract": "node scripts/check-contract.mjs",
    "check:layer": "node scripts/check-layer.mjs",
    "typecheck": "tsc --build kernel/tsconfig.json",
    "test": "node --test tests/**/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
