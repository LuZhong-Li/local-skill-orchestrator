{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "electron.vite.config.ts",
    "bridge/**/*.ts",
    "main/**/*.ts",
    "preload/**/*.ts",
    "renderer/env.d.ts",
    "renderer/src/**/*.ts",
    "renderer/src/**/*.vue"
  ]
}
